# Environment variables for MIMENTEHOY
# Copy this file to .env.local or your server environment and fill in the real values.

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mimentehoy"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Shopify
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_API_VERSION="2024-01"

# Email / newsletter
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# MailerLite (optional for newsletter forwarding)
MAILERLITE_API_KEY=""  # Add this as Netlify env var (MAILERLITE_API_KEY) when deploying to forward subscribers to MailerLite

# Admin — protects write access to the CMS API routes (articles/resources)
# until real multi-user auth lands on top of the Hostinger DB.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# App
APP_URL="http://localhost:3000"
SITE_NAME="MIMENTEHOY"
