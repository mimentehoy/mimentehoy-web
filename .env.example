# Environment variables for MIMENTEHOY
# Copy this file to .env.local or your server environment and fill in the real values.

NODE_ENV=development
PORT=3000

# Database — production runs on Netlify's managed Postgres (the
# @netlify/database integration injects NETLIFY_DB_URL automatically at
# build/runtime; lib/db.ts falls back to it when DATABASE_URL isn't set).
# For local dev, point this at your own Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/mimentehoy"

# Auth — session cookies are signed with this (see src/lib/session.ts).
# Any long random string works; changing it invalidates all sessions.
SESSION_SECRET="replace-with-a-long-random-secret"

# Shopify Storefront API — read-only, used by /tienda to display real
# products. Create a Storefront API access token in Shopify admin
# (Settings > Apps and sales channels > Develop apps > your app >
# Storefront API). Without these, /tienda falls back to the placeholder
# list in src/data/site.ts. Checkout still happens on Shopify itself —
# nothing here touches payments or orders.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_API_VERSION="2024-10"

# Email / newsletter
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# MailerLite (optional for newsletter forwarding)
MAILERLITE_API_KEY=""  # Add this as Netlify env var (MAILERLITE_API_KEY) when deploying to forward subscribers to MailerLite

# App
APP_URL="http://localhost:3000"
SITE_NAME="MIMENTEHOY"
