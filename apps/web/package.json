{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node ./copy-functions.js",
    "clean": "node ./clean-build.js",
    "db:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "db:push": "node ./scripts/db-push.js",
    "build": "node ./clean-build.js && npm run db:generate && npm run db:push && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "@prisma/client": "^6.0.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
